# Servidor
PORT=3000
HOST=127.0.0.1

# Proteção do painel. Defina uma senha forte antes de expor na internet.
PANEL_PASSWORD=
SESSION_SECRET=

# Chave usada para criptografar os tokens dos bots em repouso.
# Se ficar vazia, o servidor gera data/.store-key automaticamente.
APP_SECRET=

# Use 1 somente quando estiver atrás de um proxy reverso confiável.
TRUST_PROXY=0

# URL pública HTTPS usada para webhook. Sem ela, o sistema usa long polling.
PUBLIC_BASE_URL=

# Banco de Dados nativo da Vercel (Vercel KV / Upstash Redis)
# No painel da Vercel: Storage > Create Database > KV.
# Ao conectar ao projeto, essas variáveis são preenchidas automaticamente pela Vercel:
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Banco de Dados alternativo (Supabase)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Integração de Pagamento PIX (SyncPay)
# SYNCPAY_CLIENT_ID=
# SYNCPAY_CLIENT_SECRET=

# Sincronização automática por long polling (desative na Vercel).
TELEGRAM_POLLING=true
POLL_INTERVAL_MS=25000

# Diretório de dados. O padrão é ./data
DATA_DIR=
